---
export interface Props {
  title?: string;
  description?: string;
  activePage?: string;
}
const {
  title = "Amanda Wong",
  description = "Finance Systems & FP&A Leader helping organizations improve planning, performance management, and decision-making.",
  activePage = ""
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Netlify Identity — loads on all pages so login state persists across navigation -->
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script>
    // Redirect /admin users back after login
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet" />

  <style is:global>
    :root {
      --bg-canvas:     #0d1117;
      --bg-surface:    #161b22;
      --bg-elevated:   #1c2128;
      --bg-overlay:    #21262d;
      --border:        #30363d;
      --border-subtle: #21262d;
      --text-primary:  #e6edf3;
      --text-secondary:#8b949e;
      --text-muted:    #484f58;
      --accent:        #2f81f7;
      --accent-dim:    rgba(47,129,247,0.35);
      --accent-glow:   rgba(47,129,247,0.15);
      --accent-subtle: rgba(47,129,247,0.08);
      --green:         #3fb950;
      --amber:         #d29922;
      --red:           #f85149;
      --radius-sm:     6px;
      --radius-md:     10px;
      --radius-lg:     16px;
      --shadow-md:     0 4px 16px rgba(0,0,0,0.5);
      --shadow-lg:     0 12px 40px rgba(0,0,0,0.6);
      --font-display:  'Space Grotesk', sans-serif;
      --font-body:     'DM Sans', sans-serif;
      --font-mono:     'DM Mono', monospace;
      --ease:          cubic-bezier(0.4, 0, 0.2, 1);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg-canvas);
      color: var(--text-primary);
      font-family: var(--font-body);
      font-weight: 400;
      line-height: 1.6;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* Override any theme that makes links purple */
    a { color: #58a6ff; text-decoration: none; transition: color 0.2s; }
    a:hover { color: #79b8ff; }
    a:visited { color: #58a6ff; }
    ul { list-style: none; }
    img { max-width: 100%; }
    button { font-family: var(--font-body); cursor: pointer; }

    /* ── CONTAINER: fixed side padding, never touches edges ── */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }
    .container--narrow { max-width: 900px; }

    /* Cards */
    .card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.75rem; transition: border-color 0.2s, box-shadow 0.2s; }
    .card:hover { border-color: var(--accent-dim); box-shadow: var(--shadow-md); }

    /* Divider */
    .divider { height: 1px; background: linear-gradient(90deg, transparent, var(--border), transparent); margin: 2.5rem 0; }

    /* Section */
    .section { padding: 4rem 0; }
    .section-header { margin-bottom: 2.25rem; }
    .section-label { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: #58a6ff; margin-bottom: 0.5rem; }
    /* Fixed size — no vw scaling that causes overflow */
    .section-title { font-family: var(--font-display); font-size: 1.9rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; margin-bottom: 0.65rem; color: #e6edf3; }
    .section-desc { color: var(--text-secondary); font-size: 0.95rem; max-width: 520px; font-weight: 300; line-height: 1.7; }

    /* Page header — fixed sizes, no vw */
    .page-header { padding: 2.5rem 0 2rem; border-bottom: 1px solid var(--border); margin-bottom: 2.5rem; }
    .page-header__back { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; color: #484f58 !important; margin-bottom: 0.9rem; transition: color 0.2s; }
    .page-header__back:hover { color: #8b949e !important; }
    .page-header__title { font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin-bottom: 0.6rem; color: #e6edf3; }
    .page-header__desc { color: #8b949e; font-size: 0.925rem; font-weight: 300; max-width: 600px; line-height: 1.6; }

    /* Forms */
    .form-group { margin-bottom: 1.1rem; }
    .form-group label { display: block; font-size: 0.82rem; font-weight: 500; color: #8b949e; margin-bottom: 0.35rem; }
    .form-group input,
    .form-group textarea,
    .form-group select {
      width: 100%; background: var(--bg-canvas); border: 1px solid var(--border);
      border-radius: var(--radius-sm); color: #e6edf3; padding: 0.6rem 0.85rem;
      font-size: 0.875rem; font-family: var(--font-body);
      transition: border-color 0.2s, box-shadow 0.2s;
      appearance: none; -webkit-appearance: none;
    }
    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus { outline: none; border-color: #2f81f7; box-shadow: 0 0 0 3px rgba(47,129,247,0.15); }
    .form-group textarea { min-height: 110px; resize: vertical; line-height: 1.6; }

    /* Chips */
    .chip { display: inline-block; background: #21262d; border: 1px solid #30363d; border-radius: var(--radius-sm); padding: 0.22rem 0.6rem; font-size: 0.72rem; font-family: var(--font-mono); color: #8b949e; white-space: nowrap; transition: all 0.2s; }
    .chip:hover { color: #58a6ff; border-color: rgba(47,129,247,0.35); background: rgba(47,129,247,0.08); }
    .chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }

    /* Empty state */
    .empty-state { text-align: center; padding: 3rem 2rem; }
    .empty-state__icon { font-size: 2.25rem; margin-bottom: 0.65rem; opacity: 0.35; }
    .empty-state__title { font-family: var(--font-display); font-size: 0.95rem; color: #8b949e; margin-bottom: 0.35rem; }
    .empty-state__desc { font-size: 0.8rem; color: #484f58; }

    /* Search */
    .search-wrap { position: relative; }
    .search-icon { position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); color: #484f58; font-size: 0.82rem; pointer-events: none; }
    .search-input { width: 100%; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 0.55rem 1rem 0.55rem 2.3rem; font-size: 0.875rem; font-family: var(--font-body); color: #e6edf3; transition: all 0.2s; }
    .search-input::placeholder { color: #484f58; }
    .search-input:focus { outline: none; border-color: #2f81f7; box-shadow: 0 0 0 3px rgba(47,129,247,0.15); }

    /* Animations */
    @keyframes fadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
    .fade-up  { animation: fadeUp 0.45s var(--ease) forwards; }
    .delay-1  { animation-delay: 0.08s; opacity: 0; }
    .delay-2  { animation-delay: 0.16s; opacity: 0; }
    .delay-3  { animation-delay: 0.24s; opacity: 0; }
    .delay-4  { animation-delay: 0.32s; opacity: 0; }

    @media (max-width: 768px) {
      .container { padding: 0 1.25rem; }
      .section { padding: 2.75rem 0; }
      .page-header__title { font-size: 1.9rem; }
      .section-title { font-size: 1.5rem; }
    }
  </style>
</head>

<body>
  <nav>
    <style>
      nav {
        position: sticky; top: 0; z-index: 100;
        background: rgba(13,17,23,0.9);
        backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid #30363d;
        height: 56px; display: flex; align-items: center;
        padding: 0 2rem; justify-content: space-between;
      }
      .nav-brand { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; letter-spacing: -0.03em; color: #e6edf3 !important; text-decoration: none !important; }
      .nav-brand span { color: #58a6ff; }
      .nav-links { display: flex; gap: 0.1rem; align-items: center; }
      .nav-links a { color: #8b949e !important; font-size: 0.84rem; font-weight: 500; padding: 0.35rem 0.75rem; border-radius: 6px; transition: all 0.2s; text-decoration: none !important; }
      .nav-links a:hover  { color: #e6edf3 !important; background: #21262d; }
      .nav-links a.active { color: #58a6ff !important; background: rgba(47,129,247,0.08); }
      @media (max-width: 560px) { nav { padding: 0 1rem; } .nav-links a { padding: 0.3rem 0.5rem; font-size: 0.78rem; } }
    </style>
    <a href="/" class="nav-brand">Amanda<span>.</span></a>
    <div class="nav-links">
      <a href="/"             class={activePage === "home"         ? "active" : ""}>Home</a>
      <a href="/professional" class={activePage === "professional" ? "active" : ""}>Professional</a>
      <a href="/reviews"      class={activePage === "reviews"      ? "active" : ""}>Reviews</a>
      <a href="/news"         class={activePage === "news"         ? "active" : ""}>News</a>
      <a href="/contact"      class={activePage === "contact"      ? "active" : ""}>Contact</a>
    </div>
  </nav>

  <slot />

  <footer>
    <style>
      footer { border-top: 1px solid #30363d; padding: 1.6rem 0; text-align: center; font-family: var(--font-mono); font-size: 0.73rem; color: #484f58; }
    </style>
    <div class="container">© {new Date().getFullYear()} Amanda Wong</div>
  </footer>
</body>
</html>
