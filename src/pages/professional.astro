---
import MainLayout from '../layouts/MainLayout.astro';

const roles = [
  {
    title: "Senior Manager, Adaptive Planning & FP&A",
    company: "Lightspeed Commerce",
    location: "Toronto",
    period: "Feb 2023 – Present",
    current: true,
    summary: "Owner of Adaptive Planning and Finance Systems team — architecting financial models, maintaining SOX controls, and compressing forecast cycles from quarterly to monthly to give business leaders a real-time base/bear/bull view.",
    tags: ["Workday Adaptive Planning", "NetSuite", "Workday", "SOX", "FP&A"],
  },
  {
    title: "Manager, Enterprise Performance Management",
    company: "KPMG",
    location: "Toronto",
    period: "Jul 2020 – Feb 2023",
    current: false,
    summary: "Led end-to-end Workday Adaptive Planning engagements for clients in telecom, utilities, and financial services; drove Finance Transformation programs covering operating model design, account reconciliation tooling, and data strategy; managed 7 direct reports.",
    tags: ["Adaptive Planning", "Finance Transformation", "EPM", "Consulting"],
  },
  {
    title: "Principal Consultant, Technical Team",
    company: "Newcomp Analytics",
    location: "Thornhill",
    period: "Mar 2019 – Jul 2020",
    current: false,
    summary: "Led a team implementing Adaptive Insights and Vena for clients in property management, banking, and construction — covering discovery, solution architecture, ERP integrations, and pre-sales demos.",
    tags: ["Adaptive Insights", "Vena", "Pentaho", "ERP Integrations"],
  },
  {
    title: "Senior Consultant, Professional Services",
    company: "Prophix Software",
    location: "Mississauga & Reading, England",
    period: "Sep 2016 – Mar 2019",
    current: false,
    summary: "Delivered CPM implementations across Canada, the US, Bermuda, Jamaica, and the UK — including a 7-month secondment to Reading, England to lead construction and manufacturing engagements independently.",
    tags: ["Prophix", "CPM", "SSIS", "International"],
  },
  {
    title: "Manager, Finance",
    company: "Bell Canada",
    location: "Mississauga",
    period: "Nov 2012 – Sep 2016",
    current: false,
    summary: "Architected a SAP BW → SAS → Tableau pipeline for a $70M/month handset portfolio; a returns analysis generated $28M in annual write-off savings; automated Service Revenue reporting for a $500M/month portfolio.",
    tags: ["SAP BW", "Tableau", "SAS", "Process Automation"],
  },
  {
    title: "Business Analyst, Compensation",
    company: "Bell Canada",
    location: "Mississauga",
    period: "Jun 2010 – Nov 2012",
    current: false,
    summary: "Automated a $60M/month dealer payment process in Access + SQL, cutting processing from one week to one hour and recovering $6.5M in overpayments — earning a Bell Excellence Award.",
    tags: ["Access", "SQL", "Compensation Analytics"],
  },
];

const highlights = [
  { icon: "🌍", label: "International Experience", detail: "7-month secondment in Reading, England plus client work in the US, Bermuda, Jamaica, and Northern Ireland." },
  { icon: "🏛️", label: "Board President",          detail: "President of the Board of Directors, TCECC No. 2966 — overseeing governance, financials, and strategic planning." },
  { icon: "🔷", label: "Workday Design Partner",   detail: "Works directly with Workday's product team to shape future capabilities and influence roadmap direction." },
  { icon: "⚙️", label: "Finance Systems Leader",   detail: "17 years spanning FP&A, EPM/CPM platforms, ERP integrations, BI tooling, and enterprise-wide transformation." },
];

const skillGroups = [
  { label: "EPM / CPM",           chips: ["Workday Adaptive Planning", "Pigment", "OneStream", "Oracle EPBCS", "Vena", "Prophix", "IBM TM1"] },
  { label: "Business Intelligence", chips: ["Tableau", "Power BI", "Alteryx", "MicroStrategy", "SAS", "Looker", "BigQuery"] },
  { label: "ERP & Data",          chips: ["NetSuite", "Workday", "Yardi", "SAP BW", "SAP HANA", "SQL", "Pentaho"] },
  { label: "Reconciliation",      chips: ["Oracle ARCS", "BlackLine"] },
  { label: "Project Tools",       chips: ["Confluence", "JIRA", "Azure DevOps", "Monday.com", "Miro"] },
];
---

<MainLayout title="Professional — Amanda Wong" activePage="professional">
<style>
  /* ── HIGHLIGHT STRIP ── */
  .highlight-strip {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 1px; background: #30363d;
    border: 1px solid #30363d; border-radius: 16px;
    overflow: hidden; margin-bottom: 2.75rem;
  }
  .hl-card { background: #161b22; padding: 1.35rem 1.1rem; transition: background 0.2s; }
  .hl-card:hover { background: #1c2128; }
  .hl-icon { font-size: 1.25rem; margin-bottom: 0.6rem; display: block; }
  .hl-label { font-family: var(--font-display); font-size: 0.88rem; font-weight: 700; letter-spacing: -0.02em; color: #e6edf3; margin-bottom: 0.4rem; line-height: 1.25; }
  .hl-detail { font-size: 0.77rem; color: #8b949e; line-height: 1.55; font-weight: 300; }

  /* ── TWO-COL ── */
  .two-col { display: grid; grid-template-columns: 1fr 300px; gap: 2.25rem; align-items: start; }

  /* ── TIMELINE ── */
  .timeline { position: relative; padding-left: 1.5rem; }
  .timeline::before {
    content: ''; position: absolute; left: 0; top: 10px; bottom: 0; width: 1px;
    background: linear-gradient(180deg, #2f81f7 0%, #30363d 55%, transparent 100%);
  }
  .tl-item { position: relative; padding-bottom: 2rem; }
  .tl-item:last-child { padding-bottom: 0; }
  .tl-dot { position: absolute; left: -1.875rem; top: 8px; width: 9px; height: 9px; border-radius: 50%; border: 2px solid #0d1117; }
  .tl-dot--current { background: #2f81f7; box-shadow: 0 0 10px rgba(47,129,247,0.55); }
  .tl-dot--past { background: #484f58; }
  .tl-meta { font-family: var(--font-mono); font-size: 0.69rem; color: #484f58; letter-spacing: 0.04em; margin-bottom: 0.22rem; }
  .tl-role { font-family: var(--font-display); font-size: 1rem; font-weight: 600; letter-spacing: -0.02em; color: #e6edf3; margin-bottom: 0.15rem; line-height: 1.3; }
  .tl-company { font-size: 0.82rem; color: #58a6ff !important; font-weight: 500; margin-bottom: 0.55rem; }
  .tl-summary { font-size: 0.865rem; color: #8b949e; line-height: 1.65; font-weight: 300; margin-bottom: 0.7rem; }
  .tl-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .tl-tag {
    display: inline-block; padding: 0.18rem 0.55rem;
    background: #21262d; border: 1px solid #30363d; border-radius: 6px;
    font-family: var(--font-mono); font-size: 0.69rem; color: #8b949e; white-space: nowrap;
  }

  /* ── SIDEBAR ── */
  .sidebar { position: sticky; top: 70px; }

  /* CTA card — fixed width, buttons always inside */
  .cta-card {
    background: rgba(47,129,247,0.07);
    border: 1px solid rgba(47,129,247,0.3);
    border-radius: 14px;
    padding: 1.1rem;
    margin-bottom: 1rem;
    box-sizing: border-box;
    width: 100%;
    overflow: hidden;       /* nothing can bleed out */
  }
  .cta-card__title {
    font-family: var(--font-mono); font-size: 0.65rem;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: #58a6ff; margin-bottom: 0.55rem;
  }
  .cta-card__desc {
    font-size: 0.77rem; color: #8b949e; line-height: 1.55;
    margin-bottom: 0.85rem; font-weight: 300;
  }
  /* Buttons: block, full-width, no overflow */
  .cta-btn {
    display: block;
    width: 100%;
    text-align: center;
    padding: 0.55rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none !important;
    transition: all 0.2s;
    margin-bottom: 0.45rem;
    font-family: var(--font-body);
    cursor: pointer;
    border: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    box-sizing: border-box;
  }
  .cta-btn:last-child { margin-bottom: 0; }
  .cta-btn--primary { background: #2f81f7; color: #fff !important; }
  .cta-btn--primary:hover { background: #388bfd; color: #fff !important; }
  .cta-btn--outline {
    background: transparent; color: #e6edf3 !important;
    border: 1px solid #30363d !important;
  }
  .cta-btn--outline:hover { border-color: rgba(47,129,247,0.4) !important; color: #58a6ff !important; background: rgba(47,129,247,0.07); }

  .sidebar-card {
    background: #161b22; border: 1px solid #30363d;
    border-radius: 14px; padding: 1.1rem; margin-bottom: 1rem;
    box-sizing: border-box; width: 100%;
  }
  .sidebar-card__title { font-family: var(--font-mono); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; color: #484f58; margin-bottom: 0.85rem; }
  .skill-group { margin-bottom: 0.85rem; }
  .skill-group:last-child { margin-bottom: 0; }
  .skill-group__label { font-size: 0.66rem; color: #484f58; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.38rem; }
  .skill-chips { display: flex; flex-wrap: wrap; gap: 0.28rem; }
  .skill-chip {
    display: inline-block; background: #21262d; border: 1px solid #30363d; border-radius: 5px;
    padding: 0.18rem 0.5rem; font-size: 0.68rem; font-family: var(--font-mono);
    color: #8b949e; white-space: nowrap; transition: all 0.2s;
  }
  .skill-chip:hover { color: #58a6ff; border-color: rgba(47,129,247,0.35); background: rgba(47,129,247,0.08); }
  .mini-list { list-style: none; padding: 0; }
  .mini-list li { display: flex; align-items: flex-start; gap: 0.45rem; padding: 0.42rem 0; border-bottom: 1px solid #21262d; font-size: 0.77rem; color: #8b949e; line-height: 1.35; }
  .mini-list li:last-child { border-bottom: none; }
  .mini-dot { width: 6px; height: 6px; border-radius: 50%; background: #2f81f7; flex-shrink: 0; margin-top: 0.32rem; }
  .mini-dot--amber { background: #d29922; }
  .mini-year { font-family: var(--font-mono); font-size: 0.65rem; color: #484f58; margin-left: auto; white-space: nowrap; padding-left: 0.4rem; }

  @media (max-width: 900px) {
    .two-col { grid-template-columns: 1fr; }
    .sidebar { position: static; }
    .highlight-strip { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) { .highlight-strip { grid-template-columns: 1fr; } }
</style>

<div class="container">

  <div class="page-header fade-up">
    <a href="/" class="page-header__back">← Home</a>
    <h1 class="page-header__title">Professional</h1>
    <p class="page-header__desc">Finance Systems &amp; FP&amp;A leader with 17 years of experience transforming how organizations plan, report, and make decisions through technology.</p>
  </div>

  <div class="highlight-strip fade-up delay-1">
    {highlights.map(h => (
      <div class="hl-card">
        <span class="hl-icon">{h.icon}</span>
        <div class="hl-label">{h.label}</div>
        <div class="hl-detail">{h.detail}</div>
      </div>
    ))}
  </div>

  <div class="two-col">

    <!-- TIMELINE -->
    <div>
      <div class="section-header fade-up delay-2">
        <div class="section-label">Experience</div>
        <h2 class="section-title">Career Journey</h2>
      </div>
      <div class="timeline fade-up delay-3">
        {roles.map(role => (
          <div class="tl-item">
            <div class={`tl-dot tl-dot--${role.current ? 'current' : 'past'}`}></div>
            <div class="tl-meta">{role.period} · {role.location}</div>
            <div class="tl-role">{role.title}</div>
            <div class="tl-company">{role.company}</div>
            <p class="tl-summary">{role.summary}</p>
            <div class="tl-tags">
              {role.tags.map(t => <span class="tl-tag">{t}</span>)}
            </div>
          </div>
        ))}
      </div>

      <div class="divider"></div>

      <div class="section-header">
        <div class="section-label">Leadership</div>
        <h2 class="section-title">Board Experience</h2>
      </div>
      <div class="card fade-up">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:0.6rem;margin-bottom:0.55rem;">
          <div>
            <div style="font-family:var(--font-display);font-size:1rem;font-weight:600;letter-spacing:-0.02em;color:#e6edf3;">President of the Board of Directors</div>
            <div style="font-size:0.82rem;color:#58a6ff;margin-top:0.18rem;">TCECC No. 2966 &amp; Shared Services, North York</div>
          </div>
          <span style="display:inline-block;padding:0.18rem 0.6rem;background:rgba(63,185,80,0.1);border:1px solid rgba(63,185,80,0.3);border-radius:20px;font-size:0.7rem;color:#3fb950;font-family:var(--font-mono);white-space:nowrap;flex-shrink:0;">May 2023 – Present</span>
        </div>
        <p style="font-size:0.865rem;color:#8b949e;line-height:1.65;font-weight:300;">Oversee governance and strategic planning in quarterly board meetings; review and approve financial statements, budgets, and major corporate expenditures.</p>
      </div>

      <div class="divider"></div>

      <div class="section-header">
        <div class="section-label">Education</div>
        <h2 class="section-title">Academic Background</h2>
      </div>
      <div class="card fade-up">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.6rem;">
          <div>
            <div style="font-family:var(--font-display);font-size:1rem;font-weight:600;letter-spacing:-0.02em;color:#e6edf3;">Bachelor of Commerce (BCom)</div>
            <div style="font-size:0.82rem;color:#58a6ff;margin-top:0.18rem;">Rotman Commerce, University of Toronto</div>
            <div style="font-size:0.75rem;color:#484f58;margin-top:0.12rem;font-family:var(--font-mono);">Specialist in Accounting</div>
          </div>
          <span style="display:inline-block;padding:0.18rem 0.6rem;background:rgba(47,129,247,0.1);border:1px solid rgba(47,129,247,0.3);border-radius:20px;font-size:0.7rem;color:#58a6ff;font-family:var(--font-mono);">2010</span>
        </div>
      </div>
    </div>

    <!-- SIDEBAR -->
    <aside class="sidebar fade-up delay-2">

      <!-- CTA — both buttons always inside the box -->
      <div class="cta-card">
        <div class="cta-card__title">Open to Opportunities</div>
        <p class="cta-card__desc">
          Targeting <strong style="color:#e6edf3;font-weight:500;">Director, FP&amp;A</strong> and
          <strong style="color:#e6edf3;font-weight:500;">Director, Finance Systems</strong> roles.
        </p>
        <a href="https://www.linkedin.com/in/amanda-w-123489177" target="_blank" rel="noopener" class="cta-btn cta-btn--primary">
          Connect on LinkedIn
        </a>
        <!-- Place resume.pdf in your /public folder, then this link works automatically -->
        <a href="/resume.pdf" download="Amanda_Wong_Resume.pdf" class="cta-btn cta-btn--outline">
          ↓ Download Resume
        </a>
      </div>

      <div class="sidebar-card">
        <div class="sidebar-card__title">Technical Skills</div>
        {skillGroups.map(group => (
          <div class="skill-group">
            <div class="skill-group__label">{group.label}</div>
            <div class="skill-chips">
              {group.chips.map(c => <span class="skill-chip">{c}</span>)}
            </div>
          </div>
        ))}
      </div>

      <div class="sidebar-card">
        <div class="sidebar-card__title">Certifications</div>
        <ul class="mini-list">
          <li><span class="mini-dot"></span>Workday Adaptive Planning Platform<span class="mini-year">2022</span></li>
          <li><span class="mini-dot"></span>Oracle Account Reconciliations<span class="mini-year">2021</span></li>
          <li><span class="mini-dot"></span>Vena – Financial Reporting &amp; Budgeting<span class="mini-year">2019</span></li>
          <li><span class="mini-dot"></span>Workday Adaptive Planning<span class="mini-year">2019</span></li>
        </ul>
      </div>

      <div class="sidebar-card">
        <div class="sidebar-card__title">Awards</div>
        <ul class="mini-list">
          <li><span class="mini-dot mini-dot--amber"></span>KPMG Spotlight Award<span class="mini-year">2021–22</span></li>
          <li><span class="mini-dot mini-dot--amber"></span>Bell Excellence Award<span class="mini-year">2012</span></li>
          <li><span class="mini-dot mini-dot--amber"></span>Bell Finance Monthly Awards<span class="mini-year">2013–15</span></li>
        </ul>
      </div>

    </aside>
  </div>
</div>
<div style="padding-bottom:4rem;"></div>
</MainLayout>
